        .docs-section { margin-top: 12px; font-size: 0.8rem; border-top: 1px dashed #30363d; padding-top: 10px; }
        .docs-section span { color: #e3b341; display: block; margin-bottom: 5px; }
        .doc-link { color: #58a6ff; text-decoration: none; display: inline-block; margin-right: 15px; margin-bottom: 5px; }
        .doc-link:hover { text-decoration: underline; }
        .external-link { display: inline-block; margin-top: 10px; color: #58a6ff; text-decoration: none; font-size: 0.8rem; border: 1px solid #1f6feb; padding: 4px 8px; border-radius: 3px; background: #0d1117; }
