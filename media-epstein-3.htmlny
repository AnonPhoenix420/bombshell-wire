        .feed-card { background: #161b22; border: 1px solid #30363d; padding: 20px; border-radius: 6px; }
        .feed-card h3 { color: #ff3333; font-size: 1rem; margin-top: 0; }
        iframe { width: 100%; height: 220px; border: none; background: #000; border-radius: 4px; margin-top: 10px; }
        .dialogue-box { background: #0d1117; border-left: 3px solid #39d353; padding: 12px; margin-top: 15px; font-size: 0.85rem; color: #8b949e; line-height: 1.4; }
